# Variáveis PÚBLICAS do build de produção (VITE_* vai para o JS que o navegador baixa; nada secreto mora aqui).
#
# O site tem dois builds do mesmo commit: a Vercel (HTML) e o Cloudflare Pages (JS, CSS, imagens). O navegador usa o JS do
# Cloudflare, então o comportamento do app é o do build DELE. Por isso o que define o comportamento do app fica aqui, no
# repositório, que as duas leem. O valor do painel, se houver, vence este arquivo.

# API (Render).
VITE_API_URL=https://chacoaxis-backend.onrender.com

# CDN que serve /assets, imagens do catálogo, ícones e dados da teia (o Cloudflare Pages). Se ela falhar, o site usa a cópia
# local (ver src/utils/assetUrl.ts e vite.config.ts).
VITE_ASSETS_CDN=https://12axes-6b7.pages.dev

# Imagens do catálogo saem da CDN acima. Para voltar ao jsDelivr, descomente a linha abaixo (imagem nova só aparece nele
# depois do push):
# VITE_ASSET_BASE=https://cdn.jsdelivr.net/gh/RomanCypherpunk/12axes@main/frontend/public
